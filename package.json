{
  "name": "dev-map-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "bun scripts/check-content.ts",
    "verify": "bun run check && bun run typecheck && bun run content:check && bun run test && bun run build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "codemirror": "6.0.2",
    "dexie": "^4.2.1",
    "gray-matter": "4.0.3",
    "markdown-it": "14.1.0",
    "next": "16.4.4",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^3.15.0",
    "sucrase": "^3.35.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.9.3",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=22"
  }
}
